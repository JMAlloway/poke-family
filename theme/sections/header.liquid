<nav class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-border/50">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-heading text-2xl font-bold tracking-tight hover:scale-105 transition-transform" style="color: hsl(45, 95%, 55%);">
      Poke<span style="color: hsl(350, 85%, 60%);">Bundles</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-medium hover:text-primary transition-colors">Home</a>
      <a href="/collections/all" class="text-sm font-medium hover:text-primary transition-colors">Shop Bundles</a>
      {% if section.settings.guide_page != blank %}
        <a href="{{ section.settings.guide_page }}" class="text-sm font-bold transition-colors flex items-center gap-1" style="color: hsl(350, 85%, 60%);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Parent's Guide
        </a>
      {% else %}
        <a href="/pages/guide" class="text-sm font-bold transition-colors flex items-center gap-1" style="color: hsl(350, 85%, 60%);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Parent's Guide
        </a>
      {% endif %}
      <a href="/pages/about" class="text-sm font-medium hover:text-primary transition-colors">Our Story</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a href="/search" class="inline-flex items-center justify-center rounded-full w-10 h-10 hover:bg-secondary/50 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <a href="/cart" class="inline-flex items-center justify-center rounded-full w-10 h-10 hover:bg-secondary/50 transition-colors relative">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        {% if cart.item_count > 0 %}
          <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] text-white text-[10px] font-bold rounded-full flex items-center justify-center border-2 border-white" style="background: hsl(350, 85%, 60%);">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle" class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full hover:bg-secondary/50">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border/50 bg-white">
    <div class="flex flex-col gap-4 p-6">
      <a href="/" class="text-lg font-medium">Home</a>
      <a href="/collections/all" class="text-lg font-medium">Shop Bundles</a>
      <a href="/pages/guide" class="text-lg font-bold" style="color: hsl(350, 85%, 60%);">Parent's Guide</a>
      <a href="/pages/about" class="text-lg font-medium">Our Story</a>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "url",
      "id": "guide_page",
      "label": "Parent's Guide page link"
    }
  ]
}
{% endschema %}

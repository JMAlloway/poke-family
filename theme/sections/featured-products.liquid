<section class="py-20 container mx-auto px-4">
  <div class="text-center mb-12 space-y-4">
    <h2 class="text-3xl md:text-5xl font-heading font-bold">{{ section.settings.heading | default: "Trending Bundles" }}</h2>
    <p class="text-muted-foreground max-w-2xl mx-auto">
      {{ section.settings.subheading | default: "Our most popular packs, curated to give you the best pulls and the most fun." }}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_count %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% for product in collections['all'].products limit: section.settings.products_count %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>

  <div class="mt-12 text-center">
    <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-bold bg-secondary text-primary hover:bg-secondary/80 transition-colors">
      View All Products
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Bundles"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most popular packs, curated to give you the best pulls and the most fun."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}

<!-- Header -->
<div class="bg-secondary/30 pt-20 pb-32 relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10 text-center max-w-4xl">
    <span class="inline-flex items-center rounded-full px-4 py-1 text-base font-bold text-white mb-6" style="background: hsl(350, 85%, 60%);">Parent's Handbook 101</span>
    <h1 class="text-5xl md:text-7xl font-heading font-bold mb-8 text-foreground leading-tight">
      Become a <span class="text-primary">Pok&eacute;mon Pro</span> (Overnight)
    </h1>
    <p class="text-xl md:text-2xl text-muted-foreground leading-relaxed">
      The jargon-free, stress-free guide to understanding what your kids are talking about.
    </p>
  </div>
  <div class="absolute -bottom-16 left-0 right-0 h-32 bg-background transform -skew-y-2 origin-bottom-right"></div>
</div>

<div class="container mx-auto px-4 -mt-20 relative z-20 mb-20">
  <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
    <img src="{{ 'guide-hero.png' | asset_url }}" alt="Parent and child learning" class="w-full h-[400px] object-cover">
  </div>
</div>

<!-- Content -->
<div class="container mx-auto px-4 max-w-4xl space-y-24 mb-24">

  <!-- Section 1: Rarity -->
  <section id="rarity">
    <h2 class="text-3xl font-heading font-bold mb-6 flex items-center gap-3">
      <span class="w-10 h-10 rounded-full text-white flex items-center justify-center text-xl" style="background: hsl(45, 95%, 55%); color: hsl(220, 20%, 15%);">1</span>
      Rarity Explained
    </h2>
    <div class="bg-card border border-border rounded-2xl p-8 shadow-sm">
      <p class="text-lg text-muted-foreground mb-8">
        Look at the bottom corner of the card. You'll see a tiny symbol. That's the key to everything.
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-secondary/20 p-6 rounded-xl text-center">
          <div class="text-4xl mb-4">&#9679;</div>
          <h3 class="font-bold text-lg mb-2">Circle = Common</h3>
          <p class="text-sm text-muted-foreground">These are everywhere. Your kid will have hundreds. Great for filling binders.</p>
        </div>
        <div class="bg-secondary/20 p-6 rounded-xl text-center">
          <div class="text-4xl mb-4">&#9670;</div>
          <h3 class="font-bold text-lg mb-2">Diamond = Uncommon</h3>
          <p class="text-sm text-muted-foreground">A bit harder to find, usually stronger Pok&eacute;mon.</p>
        </div>
        <div class="p-6 rounded-xl text-center border-2" style="background: hsla(45, 95%, 55%, 0.1); border-color: hsla(45, 95%, 55%, 0.2);">
          <div class="text-4xl mb-4">&#9733;</div>
          <h3 class="font-bold text-lg mb-2">Star = Rare</h3>
          <p class="text-sm text-muted-foreground">The good stuff! Holos, VMAX, Full Arts. These are the ones to sleeve.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Real vs Fake -->
  <section id="fake-spotting">
    <h2 class="text-3xl font-heading font-bold mb-6 flex items-center gap-3">
      <span class="w-10 h-10 rounded-full text-white flex items-center justify-center text-xl" style="background: hsl(350, 85%, 60%);">2</span>
      Is It Fake?
    </h2>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-green-50 p-8 rounded-2xl border border-green-100">
        <h3 class="font-bold text-xl text-green-800 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          Real Cards
        </h3>
        <ul class="space-y-3 text-green-700 font-medium">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            Multi-layered cardboard (you can see a thin dark layer on the edge)
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            Texture! Run your finger over a rare card. It should feel textured, like a fingerprint.
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            Crisp, clear text with no spelling errors.
          </li>
        </ul>
      </div>

      <div class="bg-red-50 p-8 rounded-2xl border border-red-100">
        <h3 class="font-bold text-xl text-red-800 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
          Fake Cards
        </h3>
        <ul class="space-y-3 text-red-700 font-medium">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            Feel smooth and glossy, like cheap plastic.
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            If you hold it up to a light, you can see right through it.
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            The back of the card looks "washed out" or light blue instead of dark blue.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 3: FAQ -->
  <section>
    <h2 class="text-3xl font-heading font-bold mb-6">Common Parent Questions</h2>
    <div class="space-y-4">
      <details class="group bg-card border border-border rounded-xl overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-bold hover:bg-secondary/20 transition-colors">
          What is a "Booster Pack"?
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="px-6 pb-6 text-muted-foreground text-base">
          A booster pack is a sealed packet containing 10 random cards. It's like a lottery ticket! You're guaranteed at least one "Rare" card, but you never know exactly what you'll get. That surprise is half the fun.
        </div>
      </details>

      <details class="group bg-card border border-border rounded-xl overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-bold hover:bg-secondary/20 transition-colors">
          Why are some cards worth thousands?
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="px-6 pb-6 text-muted-foreground text-base">
          Scarcity and condition. Some cards are printed in very limited quantities. If a card is rare AND in perfect condition (no scratches, perfectly centered), collectors will pay a premium. But don't worry, 99.9% of cards are just for fun playing!
        </div>
      </details>

      <details class="group bg-card border border-border rounded-xl overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-bold hover:bg-secondary/20 transition-colors">
          How do I keep the cards safe?
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="px-6 pb-6 text-muted-foreground text-base">
          We recommend "Penny Sleeves" (thin plastic covers) for shiny cards, and a Binder for storage. Keeping them loose in a pocket or drawer is the fastest way to ruin them!
        </div>
      </details>
    </div>
  </section>

</div>

<!-- CTA -->
<section class="py-20 text-center text-white" style="background: hsl(45, 95%, 55%);">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-heading font-bold mb-6" style="color: hsl(220, 20%, 15%);">Ready to apply your knowledge?</h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto" style="color: hsla(220, 20%, 15%, 0.7);">
      Our "Starter Bundles" are the perfect, safe way to start a collection without worrying about fakes or bad deals.
    </p>
    <a href="/collections/all" class="inline-flex items-center justify-center rounded-full text-lg h-14 px-10 font-bold bg-white transition-colors" style="color: hsl(45, 95%, 55%);">
      Shop Starter Bundles
    </a>
  </div>
</section>

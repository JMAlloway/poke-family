<div class="container mx-auto px-4 py-12">
  <div class="text-center mb-12 space-y-4">
    <h1 class="text-3xl md:text-5xl font-heading font-bold">All Collections</h1>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for collection in collections %}
      {% unless collection.handle == 'all' %}
        <a href="{{ collection.url }}" class="group block bg-card rounded-2xl border border-border shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden hover:-translate-y-2">
          <div class="aspect-video overflow-hidden bg-secondary/30">
            {% if collection.image %}
              <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            {% endif %}
          </div>
          <div class="p-6">
            <h2 class="font-heading font-bold text-xl group-hover:text-primary transition-colors">{{ collection.title }}</h2>
            <p class="text-sm text-muted-foreground mt-2">{{ collection.products_count }} products</p>
          </div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</div>

<section class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary text-secondary-foreground font-bold text-sm tracking-wide">
        FOR PARENTS
      </span>
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-foreground">
        Confused by Pok&eacute;mon? <br>
        <span class="text-primary">We've Got You Covered.</span>
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed">
        You don't need to be a Pok&eacute;mon Master to be a hero to your kids.
        We break down the complex world of TCG into simple, bite-sized guides.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Card 1: Fake -->
      <a href="/pages/guide#fake-spotting" class="group p-8 rounded-3xl border-2 transition-all duration-300 bg-red-50 hover:bg-red-100 border-red-100 cursor-pointer block">
        <div class="mb-6 transform group-hover:scale-110 transition-transform duration-300">
          <img src="{{ 'icon-fake.png' | asset_url }}" alt="Spot fakes" class="w-20 h-20 object-contain drop-shadow-md">
        </div>
        <h3 class="font-heading font-bold text-xl mb-3 text-red-600">Is My Kid's Card Fake?</h3>
        <p class="text-muted-foreground font-medium leading-relaxed mb-6">3 simple signs to spot a fake card in seconds.</p>
        <div class="flex items-center font-bold text-sm text-red-600">
          Read Guide
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>

      <!-- Card 2: Rarity -->
      <a href="/pages/guide#rarity" class="group p-8 rounded-3xl border-2 transition-all duration-300 bg-blue-50 hover:bg-blue-100 border-blue-100 cursor-pointer block">
        <div class="mb-6 transform group-hover:scale-110 transition-transform duration-300">
          <img src="{{ 'icon-rarity.png' | asset_url }}" alt="Card symbols" class="w-20 h-20 object-contain drop-shadow-md">
        </div>
        <h3 class="font-heading font-bold text-xl mb-3 text-blue-600">What Do The Symbols Mean?</h3>
        <p class="text-muted-foreground font-medium leading-relaxed mb-6">Circles, diamonds, and stars explained simply.</p>
        <div class="flex items-center font-bold text-sm text-blue-600">
          Read Guide
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>

      <!-- Card 3: Rules -->
      <a href="/pages/guide#rules" class="group p-8 rounded-3xl border-2 transition-all duration-300 bg-green-50 hover:bg-green-100 border-green-100 cursor-pointer block">
        <div class="mb-6 transform group-hover:scale-110 transition-transform duration-300">
          <img src="{{ 'icon-rules.png' | asset_url }}" alt="Game rules" class="w-20 h-20 object-contain drop-shadow-md">
        </div>
        <h3 class="font-heading font-bold text-xl mb-3 text-green-600">How Do You Actually Play?</h3>
        <p class="text-muted-foreground font-medium leading-relaxed mb-6">The game rules stripped down to the basics.</p>
        <div class="flex items-center font-bold text-sm text-green-600">
          Read Guide
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>
    </div>

    <div class="mt-16 text-center">
      <a href="/pages/guide" class="inline-flex items-center justify-center rounded-full border-2 border-border text-lg h-14 px-8 font-bold text-muted-foreground hover:text-foreground hover:border-foreground transition-colors">
        View The Parent's Handbook
      </a>
    </div>
  </div>

  <!-- Background blobs -->
  <div class="absolute top-1/2 left-0 w-64 h-64 bg-secondary/50 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full blur-3xl translate-y-1/3 translate-x-1/3" style="background: hsla(45, 95%, 55%, 0.05);"></div>
</section>

{% schema %}
{
  "name": "Parent Guide Preview",
  "presets": [
    {
      "name": "Parent Guide Preview"
    }
  ]
}
{% endschema %}

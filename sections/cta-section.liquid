<section class="py-20 bg-primary/10">
  <div class="container mx-auto px-4 text-center">
    <div class="max-w-3xl mx-auto space-y-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold">{{ section.settings.heading | default: "Ready to Start Your Collection?" }}</h2>
      <p class="text-lg text-muted-foreground">
        {{ section.settings.text | default: "Join thousands of families building memories one card at a time. Perfect for birthdays, rewards, or just because!" }}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="inline-flex items-center justify-center rounded-full text-lg h-14 px-8 shadow-xl font-bold hover:scale-105 transition-transform" style="background: hsl(45, 95%, 55%); color: hsl(220, 20%, 15%); box-shadow: 0 10px 25px -5px hsla(45, 95%, 55%, 0.2);">
          {{ section.settings.cta_text | default: "Shop Now" }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to Action",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Start Your Collection?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Join thousands of families building memories one card at a time. Perfect for birthdays, rewards, or just because!"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Call to Action"
    }
  ]
}
{% endschema %}
